# Copy to .env (docker compose reads it) - never commit the real file.

# --- MongoDB (docker compose) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-locally

# --- API ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- AI (optional: leave empty to use the rule-based fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seed demo data when the DB is empty (turn off in real environments)
AUTO_SEED=true
